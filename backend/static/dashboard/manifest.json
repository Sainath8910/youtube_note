{
  "manifest_version": 3,
  "name": "YouTube Notes",
  "version": "0.1.0",
  "description": "Save video-linked notes and transcripts while watching YouTube.",
  "action": {
    "default_title": "Open YouTube Notes",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "identity"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://youtube-note-veif.onrender.com/*",
    "https://*.supabase.co/*",
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/watch*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}