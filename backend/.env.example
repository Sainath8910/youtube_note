SECRET_KEY=replace-with-a-generated-django-secret-key
DJANGO_ENV=development
DEBUG=true
EXTRA_ALLOWED_HOSTS=

DB_NAME=postgres
DB_USER=replace-with-your-supabase-database-user
DB_PASSWORD=replace-with-your-supabase-database-password
DB_HOST=aws-0-ap-northeast-1.pooler.supabase.com
DB_PORT=5432
DB_SSLMODE=require

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated

# Optional legacy HS256 support for older Supabase projects.
SUPABASE_JWT_SECRET=

# Optional local-only bypass for extension testing during DEBUG=true.
ENABLE_DEV_HEADER_AUTH=false

# Notes Bridge (Non-AI backend accepts requests from the AI backend).
# Set the same randomly generated secret (at least 32 characters) as in the AI backend.
NOTES_SYNC_PEER_SECRET=replace-with-the-same-random-secret-on-both-backends
# Set this to the AI backend's ID from: python manage.py show_sync_installation_id
NOTES_SYNC_PEER_INSTALLATION_ID=replace-with-ai-installation-id
